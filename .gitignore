# Unity project lives in FALL/ — folder patterns below are scoped to it

# Unity generated folders
FALL/[Ll]ibrary/
FALL/[Tt]emp/
FALL/[Oo]bj/
FALL/[Bb]uild/
FALL/[Bb]uilds/
FALL/[Ll]ogs/
FALL/[Uu]serSettings/
FALL/MemoryCaptures/

# Asset meta data should always accompany its asset
!FALL/[Aa]ssets/**/*.meta

# Autogenerated Jetbrains Rider plugin
FALL/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio / Rider cache directories
.vs/
.idea/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
FALL/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Temporary auto-generated Android Assets
FALL/[Aa]ssets/StreamingAssets/aa/
